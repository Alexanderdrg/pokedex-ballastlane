<!-- Keep the test output readable: only real warnings, not the errors tests provoke on purpose -->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- tests trigger 4xx/5xx paths deliberately; their stack traces are expected -->
    <logger name="com.ballastlane.pokedex.infrastructure.web.GlobalExceptionHandler" level="OFF"/>
    <!-- "Flyway upgrade recommended" for the H2 version Spring Boot manages -->
    <logger name="org.flywaydb.core.internal.database.base.Database" level="ERROR"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
